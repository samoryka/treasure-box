---
import { Image } from "astro:assets";

const { title, link, image, date } = Astro.props;

const displayDate = new Date(date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
});
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/objects/*/*.{jpeg,jpg,png,gif}",
);
---

<style>
  .card {
    display: flex;
    background-color: #e7e7e7;
    flex-direction: row;
    padding: 8px;
    border-radius: 8px;
    width: 300px;
    margin: 4px;
  }
  .card:hover {
    background-color: #ffffff;
  }

  .content {
    padding: 8px;
  }
</style>
<a href={link}>
  <div class="card">
    <Image
      src={allImages[image.src]()}
      alt={image.alt}
      height="100"
      loading="lazy"
    />
    <div class="content">
      <p>{title}</p>
      <p>{displayDate}</p>
    </div>
  </div>
</a>
