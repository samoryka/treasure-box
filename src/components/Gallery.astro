---
interface Props {
  wrap?: boolean;
}

const { wrap = true } = Astro.props;
const flexWrap = wrap ? "wrap" : "nowrap";
const width = wrap ? "auto" : "100vw";
const overflow = wrap ? "visible" : "scroll";
---

<style define:vars={{ flexWrap, width, overflow }}>
  .gallery {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    gap: var(--spacing-m);
    flex-wrap: var(--flexWrap);
    padding-top: var(--spacing-m);
    width: var(--width);
    overflow: var(--overflow);
  }

  .gallery :global(.galleryImage) {
    flex-grow: 1;
    flex-basis: 40%;
    width: 100%;
    height: auto;
    align-self: flex-start;
    border-radius: var(--border-radius-rounded);
  }

  @media (max-width: 600px) {
    .gallery :global(.galleryImage) {
      flex-basis: 100%;
    }
  }
</style>

<div class="gallery">
  <slot />
</div>
