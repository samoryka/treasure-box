---
interface Props {
  labelledBy?: string;
}

const { labelledBy } = Astro.props;
---

<style>
  .gallery {
    display: flex;
    gap: var(--spacing-m);
    flex-wrap: wrap;
    padding-top: var(--spacing-m);
    justify-content: center;
  }

  .gallery :global(.galleryImage) {
    flex-grow: 1;
    flex-basis: 40%;
    width: 100%;
    height: auto;
    /* align-self: flex-start; */
    border-radius: var(--border-radius-rounded);
  }

  @media (max-width: 600px) {
    .gallery :global(.galleryImage) {
      flex-basis: 100%;
    }
  }
</style>

<div class="gallery" role="group" aria-labelledby={labelledBy}>
  <slot />
</div>
