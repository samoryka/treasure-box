---
interface Props {
  labelledBy?: string;
  layout?: "grid" | "horizontal-scroll";
}

const { labelledBy, layout = "grid" } = Astro.props;
---

<style>
  .gallery {
    display: flex;
    gap: var(--spacing-m);
    flex-wrap: wrap;
    padding-top: var(--spacing-m);
  }

  .gallery.horizontal-scroll {
    flex-wrap: nowrap;
    width: 100vw;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .gallery :global(.galleryImage) {
    flex-grow: 1;
    flex-basis: 40%;
    width: 100%;
    height: auto;
    align-self: flex-start;
    border-radius: var(--border-radius-rounded);
  }

  @media (max-width: 600px) {
    .gallery :global(.galleryImage) {
      flex-basis: 100%;
    }
  }
</style>

<div class:list={["gallery", layout]} role="group" aria-labelledby={labelledBy}>
  <slot />
</div>
