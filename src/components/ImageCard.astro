---
import { Image } from "astro:assets";
import ImageViewer from "./ImageViewer.astro";

const { title, image, date } = Astro.props;

const displayDate = new Date(date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
});
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/*.{jpeg,jpg,png,gif}",
);
---

<style>
  .cardContainer {
    display: inline-grid;
    align-items: center;
    max-width: 100%;
  }

  .card {
    box-sizing: border-box;
    max-width: 100%;
    background-color: var(--color-white);
    padding: var(--spacing-m);
    border: 0;
    border-radius: var(--border-radius-rounded);
    color: var(--color-red);
    font: inherit;
    cursor: pointer;
    display: inline-grid;
    align-items: center;
  }

  .card:hover > .image {
    opacity: 30%;
    filter: blur(var(--blur-intense));
    transition-duration: var(--transition-duration-default);
  }

  .card:hover > .content {
    opacity: 100%;
    transition-duration: var(--transition-duration-default);
  }

  .image {
    max-width: 100%;
    border-radius: var(--border-radius-rounded);
    grid-column: 1;
    grid-row: 1;
    width: 400px;
    height: auto;
  }

  .content {
    opacity: 0;
    align-content: center;
    text-align: center;
    grid-column: 1;
    grid-row: 1;
  }

  .title {
    font-weight: bold;
  }

  .subtitle {
    display: block;
    padding-top: var(--spacing-s);
  }

  @media (max-width: 600px) {
    .card {
      width: 100%;
    }

    .image {
      width: 100%;
    }
  }
</style>

<div class="cardContainer">
  <button
    type="button"
    class="card"
    aria-label={`View ${title} full screen`}
    data-image-open
  >
    <Image
      class="image"
      src={allImages[image.src]()}
      alt={image.alt}
      loading="lazy"
    />
    <span class="content" aria-hidden="true">
      <span class="title">{title}</span>
      <span class="subtitle">{displayDate}</span>
    </span>
  </button>
  <ImageViewer title={title} image={image} date={displayDate} />
</div>
