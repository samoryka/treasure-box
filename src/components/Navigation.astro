---
const currentPath = Astro.url.pathname;
---

<style>
  nav {
    background-color: var(--color-red);
    margin: 0;
    position: fixed;
    width: 100vw;
    z-index: 100;
    padding: var(--spacing-m) var(--spacing-l);
    font-size: var(--text-size-l);
    font-family: sans-serif;
  }

  a {
    color: var(--color-beige);
    text-decoration: none;
    padding: var(--spacing-s);
  }
  a.active {
    color: var(--color-white);
    text-decoration: wavy underline;
  }

  a:hover {
    color: var(--color-white);
  }
  a:first-child {
    padding-left: 0;
  }
</style>

<nav>
  <a href="/" class={currentPath === "/" ? "active" : ""} aria-label="HOME">●</a
  >
  <a href="/objects/" class={currentPath.startsWith("/objects") ? "active" : ""}
    >OBJECTS</a
  >
  <a href="/images/" class={currentPath.startsWith("/images") ? "active" : ""}
    >IMAGES</a
  >
</nav>
