---
const currentPath = Astro.url.pathname;
---

<style>
  nav {
    background-color: var(--color-red);
    margin: 0;
    position: fixed;
    box-sizing: border-box;
    width: 100%;
    z-index: 100;
    padding: var(--spacing-m) var(--spacing-l);
    font-size: var(--text-size-l);
    font-family: sans-serif;

    display: flex;
    gap: var(--spacing-m);
    align-items: center;
  }

  a {
    color: var(--color-beige);
    text-decoration: none;
  }
  a.active {
    color: var(--color-white);
    text-decoration: wavy underline;
  }

  a:hover {
    color: var(--color-white);
  }

  .rightLink {
    margin-left: auto;
    font-size: var(--text-size-m);
  }
</style>

<nav>
  <a href="/" class={currentPath === "/" ? "active" : ""} aria-label="HOME">●</a
  >
  <a href="/objects/" class={currentPath.startsWith("/objects") ? "active" : ""}
    >OBJECTS</a
  >
  <a href="/images/" class={currentPath.startsWith("/images") ? "active" : ""}
    >IMAGES</a
  >
  <a href="/rss.xml" class="rightLink" target="_blank" rel="noopener">RSS</a>
</nav>
