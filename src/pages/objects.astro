---
import Gallery from "../components/Gallery.astro";
import ObjectCard from "../components/ObjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
const allObjects = Object.values(
  import.meta.glob("./objects/*.md", { eager: true }),
);

const byNewest = (a: any, b: any) =>
  Date.parse(b.frontmatter.creationDate) -
  Date.parse(a.frontmatter.creationDate);

const orderedObjects = allObjects.sort(byNewest);
---

<BaseLayout>
  <h1>Lamps, furniture, wooden objects</h1>
  <Gallery>
    {
      orderedObjects.map((post: any) => (
        <ObjectCard
          title={post.frontmatter.title}
          link={post.url}
          image={post.frontmatter.image}
          date={post.frontmatter.creationDate}
        />
      ))
    }
  </Gallery>
</BaseLayout>
