---
import CardGallery from "../components/CardGallery.astro";
import ObjectCard from "../components/ObjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
const allObjects = Object.values(
  import.meta.glob("./objects/*.md", { eager: true }),
);
---

<BaseLayout>
  <h1>Lamps, furniture, wooden objects</h1>
  <CardGallery>
    {
      allObjects.map((post: any) => (
        <ObjectCard
          title={post.frontmatter.title}
          link={post.url}
          image={post.frontmatter.image}
          date={post.frontmatter.creationDate}
        />
      ))
    }
  </CardGallery>
</BaseLayout>
