---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import Head from "../components/Head.astro";
import Content from "../components/Content.astro";
---

<style>
  :global(:root) {
    --color-beige: #f0e7c8;
    --color-white: #ffffff;
    --color-red: #b22000;
    --color-tan: #d89d5d;
    --color-brown: #4d1a00;
    --text-size-s: 1rem;
    --text-size-m: 1.25rem;
    --text-size-l: 1.5rem;

    --spacing-s: 0.25em;
    --spacing-m: 0.5em;
    --spacing-l: 1em;
    --spacing-xl: 4em;

    --border-radius-rounded: 12px;
    --blur-value: 1px;
    --transition-duration-default: 400ms;
  }

  body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: var(--color-beige);
    color: var(--color-red);
    font-size: var(--text-size-m);
  }
</style>

<html lang="en">
  <Head />
  <body>
    <Navigation />
    <Content>
      <slot />
    </Content>
  </body>
</html>
